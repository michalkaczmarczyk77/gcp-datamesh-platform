executor: KubernetesExecutor
images:
  airflow:
    repository: europe-central2-docker.pkg.dev/dtp-ref-dev/dtp-artifact-registry/airflow-dbt
    tag: 035736b95f322e25d95bdd2cfcf3116f3bec6774 # CI pins the real tag via `helm upgrade --set images.airflow.tag=<sha>`

env:
  - name: GCP_PROJECT
    value: "dtp-ref-dev"
  - name: DTP_ENV
    value: "dev"
  - name: DTP_BQ_LOCATION
    value: "europe-central2"

apiServer:
  replicas: 1
  resources: { requests: { cpu: "500m", memory: "1Gi" } }
  extraContainers:
    - name: cloud-sql-proxy
      image: gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.14.0
      args: ["--structured-logs", "--port=5432", "dtp-ref-dev:europe-central2:airflow-meta-dev"]
      securityContext: { runAsNonRoot: true }

scheduler:
  replicas: 1
  resources: { requests: { cpu: "500m", memory: "1Gi" } }
  extraContainers:
    - name: cloud-sql-proxy
      image: gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.14.0
      args: ["--structured-logs", "--port=5432", "dtp-ref-dev:europe-central2:airflow-meta-dev"]
      securityContext: { runAsNonRoot: true }

triggerer:
  enabled: false

postgresql:
  enabled: false

statsd:
  enabled: false

data:
  metadataConnection:
    protocol: postgresql
    host: 127.0.0.1
    user: airflow
    db: airflow
    port: 5432

workers:
  resources: { requests: { cpu: "500m", memory: "1Gi" } }
  extraContainers:
    - name: cloud-sql-proxy
      image: gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.14.0
      args: ["--structured-logs", "--port=5432", "dtp-ref-dev:europe-central2:airflow-meta-dev"]
      securityContext: { runAsNonRoot: true }

dags:
  gitSync:
    enabled: true
    repo: https://github.com/<org>/data-transformation-platform.git
    branch: main
    subPath: "domains"

serviceAccount:
  create: true
  name: airflow-scheduler
  annotations:
    iam.gke.io/gcp-service-account: sa-airflow-dev@dtp-ref-dev.iam.gserviceaccount.com
